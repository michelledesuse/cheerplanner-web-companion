{
  "expo": {
    "name": "CheerPlanner",
    "slug": "frontend",
    "version": "3.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/cheerplanner-logo.png",
    "scheme": "cheerplanner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.desuse.cheerplanner",
      "version": "3.0.2",
      "buildNumber": "117",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add a profile photo for your athletes",
        "NSPhotoLibraryAddUsageDescription": "Save designs and flyers to your photos",
        "NSCalendarsUsageDescription": "Add team events to your calendar",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Add team events to your calendar",
        "NSMicrophoneUsageDescription": "Record video clips to share in team chat",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.desuse.cheerplannerv1",
      "versionName": "3.0.0",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cheerplanner-logo-full.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-video",
      [
        "expo-calendar",
        {
          "calendarPermission": "Add team events to your calendar"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
