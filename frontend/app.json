{
  "expo": {
    "name": "CheerPlanner",
    "slug": "frontend",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/cheerplanner-logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.desuse.cheerplanner",
      "buildNumber": "6",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add a profile photo for your athletes",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.desuse.cheerplanner",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
